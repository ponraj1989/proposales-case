# Proposales Platform Environment Variables
# Copy to .env.local and fill in values

# ─── Proposales API ───────────────────────────────────────────────
PROPOSALES_API_URL=https://api.proposales.com
PROPOSALES_API_TOKEN=your_proposales_bearer_token
# Token embedded in e-sign email links for guest inbox access
PROPOSALES_INBOX_TOKEN=your_inbox_token

# ─── Google OAuth (NextAuth.js) ───────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth access control (optional, comma-separated)
# Leave empty to allow all Google accounts
ALLOWED_EMAILS=user1@example.com,user2@example.com
ALLOWED_DOMAINS=yourcompany.com

# Comma-separated emails that receive the 'sales' role on Google sign-in
# All other authenticated users receive the 'customer' role
SALES_EMAILS=sales@yourcompany.com

# ─── Passkey Auth (plaintext passkeys, role-mapped) ───────────────
# Sales passkey — grants the 'sales' role
SALES_PASSKEY_1=your_sales_passkey
# Customer passkey — grants the 'customer' role
USER_PASSKEY_1=your_user_passkey

# ─── Legacy API Key Auth (SHA-256 hashes, comma-separated) ────────
# Generate: echo -n "your-api-key" | sha256sum
AUTHORIZED_KEYS=hash1,hash2

# ─── Redis (ioredis — cache, pub/sub, rate limiting) ──────────────
# Use a standard redis:// URL (NOT Upstash REST)
REDIS_URL=redis://localhost:6379

# ─── MongoDB (Mongoose — source of truth) ─────────────────────────
MONGODB_URI=mongodb://localhost:27017/proposales

# ─── AI (Vercel AI SDK gateway) ───────────────────────────────────
OPENAI_API_KEY=your_openai_key
# Optional: override the AI model (default: openai/gpt-4o)
# AI_MODEL=openai/gpt-4o
