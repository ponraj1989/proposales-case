# Proposales Platform Environment Variables
# Copy to .env.local and fill in values

# Proposales API
PROPOSALES_API_URL=https://api.proposales.com
PROPOSALES_API_TOKEN=your_proposales_bearer_token

# Authentication - comma-separated SHA-256 hashes of authorized API keys
AUTHORIZED_KEYS=hash1,hash2

# Google OAuth (NextAuth.js)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth access control (optional, comma-separated)
# Leave empty to allow all Google accounts
ALLOWED_EMAILS=user1@example.com,user2@example.com
ALLOWED_DOMAINS=yourcompany.com

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OpenAI (Vercel AI SDK)
OPENAI_API_KEY=your_openai_key
