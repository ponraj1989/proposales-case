{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "PROPOSALES_API_URL",
        "PROPOSALES_API_TOKEN",
        "AUTHORIZED_KEYS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "ALLOWED_EMAILS",
        "ALLOWED_DOMAINS",
        "REDIS_URL",
        "OPENAI_API_KEY",
        "AI_MODEL",
        "AI_GATEWAY_API_KEY",
        "USER_PASSKEY_1",
        "USER_PASSKEY_2",
        "USER_PASSKEY_3",
        "USER_PASSKEY_4",
        "USER_PASSKEY_5",
        "SALES_PASSKEY_1",
        "SALES_EMAILS",
        "MONGODB_URI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
